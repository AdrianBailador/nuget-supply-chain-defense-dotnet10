<?xml version="1.0" encoding="utf-8"?>
<!--
  VICTIM configuration — intentionally the common real-world default.
  No <packageSourceMapping>: once "local-lab-feed" is added as a source,
  NuGet will resolve ANY package ID from it, including one that happens
  to match (or typosquat) a name you trust. This is the baseline most
  teams ship with.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-lab-feed" value="../../local-lab-feed" />
  </packageSources>
</configuration>
