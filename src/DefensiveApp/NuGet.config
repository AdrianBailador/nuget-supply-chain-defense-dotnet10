<?xml version="1.0" encoding="utf-8"?>
<!--
  DEFENDED configuration.

  packageSourceMapping is the control that matters here: once at least one
  <packageSource> pattern is declared, NuGet stops treating "any configured
  source can satisfy any package id" as the default. A package only
  restores from a source whose pattern it matches — full stop, even if you
  pass another configured source explicitly on the command line.

  Everything under this project is only allowed to come from nuget.org,
  scoped to the prefixes this project actually uses. "local-lab-feed" is
  listed as a source (so the failure mode below is "blocked by mapping",
  not "unknown source") but owns no pattern, so nothing can resolve from it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-lab-feed" value="../../local-lab-feed" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
